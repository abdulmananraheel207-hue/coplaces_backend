# Turso database. Required: the app will not start without both.
#   turso db show <name> --url
#   turso db tokens create <name>
TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
TURSO_AUTH_TOKEN=

JWT_SECRET=

# Optional: answer HTTPS on the same port, for attendance devices that connect with TLS.
#   openssl req -x509 -newkey rsa:2048 -nodes -days 825 -subj "/CN=<this PC IP>" -keyout certs/dev-key.pem -out certs/dev-cert.pem
# TLS_CERT_FILE=certs/dev-cert.pem
# TLS_KEY_FILE=certs/dev-key.pem
